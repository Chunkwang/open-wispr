# Copy to .dev.vars (gitignored) for `wrangler dev`. Placeholder values only;
# never put real keys in this file. QUOTA (the per-user quota Durable Object) is a binding,
# not a variable: wrangler dev provides it locally, with state in .wrangler/.

# Local mock Supabase (npm run dev:mock). Overrides [vars] in wrangler.toml. Tokens must carry
# iss = <this URL>/auth/v1 (npm run dev:token does that from this value).
SUPABASE_URL=http://127.0.0.1:54321
# How the Worker verifies tokens: hs256 (default, shared secret below) or jwks (asymmetric keys; then
# no secret is needed). Set in wrangler.toml [vars]; only override here for local experiments.
# JWT_VERIFY_MODE=hs256
# Must start with "local-dev-" (mint-dev-token.mjs refuses anything else). Never use a real project secret.
# This exact value is published in the repo, so the Worker refuses it (500 misconfigured) on any
# non-loopback hostname (as it does any local-dev- value or secret under 32 characters), and a test
# keeps src/hostGuard.ts in step with it. Don't change one without the other.
SUPABASE_JWT_SECRET=local-dev-jwt-secret-change-me-32-chars-min
# Used by the Worker for profile lookups; a dummy value works against the mock.
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key
# Leave as a placeholder. Real provider keys are set as Wrangler secrets, never in this file.
ANTHROPIC_API_KEY=sk-ant-placeholder
# The four placeholder values (this service-role key, whsec_placeholder, sk_test_placeholder,
# price_placeholder) are refused on the webhook and /v1/billing/* routes off loopback. Dummy
# Stripe values; against the mock (below) the SDK never checks them for real.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# The one Pro plan checkout creates a session for. The mock accepts any value.
STRIPE_PRICE_ID=price_placeholder
# Local mock Stripe (npm run dev:mock:stripe). Like SUPABASE_URL above, this is always-on dev
# infrastructure, not a per-call opt-in: with it set, POST /v1/billing/checkout and /v1/billing/portal
# talk to the mock instead of api.stripe.com. Only honored on a loopback hostname (see stripeClient.ts);
# a deployed Worker ignores it even if this line were somehow copied into its config.
STRIPE_API_BASE_URL=http://127.0.0.1:54323
# Where Checkout/the billing portal send the browser back. Optional: omit to use a placeholder
# example.com page (fine for exercising the API; there is no real domain yet — D1).
# BILLING_SUCCESS_URL=http://127.0.0.1:8787/__dev/billing-success
# BILLING_CANCEL_URL=http://127.0.0.1:8787/__dev/billing-cancel
# BILLING_PORTAL_RETURN_URL=http://127.0.0.1:8787/__dev/billing-success

# Dev-only mock LLM. Uncomment to skip the real Claude call under `wrangler dev`.
# Set here ONLY; never as a [vars] entry or Wrangler secret on the deployed Worker.
# The Worker also requires a 127.0.0.1/localhost hostname, so it cannot activate
# once deployed, but keep it out of deployed config anyway.
# LLM_PROVIDER=mock
